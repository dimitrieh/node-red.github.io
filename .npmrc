# Dependencies do not get to execute code at install time.
#
# npm 11.16 already blocks install scripts by default: `allow-scripts` ships as an
# empty allowlist, and installing this tree prints
#   "1 package has install scripts not yet covered by allowScripts: esbuild"
# meaning esbuild's script was skipped. That is a default, though, not a promise,
# and it only holds on new enough npm. `ignore-scripts` is the switch every npm
# understands, so the behaviour is the same whoever installs.
#
# Verified safe for this tree rather than assumed: the whole dependency set was
# installed with scripts blocked, and the 216-page build, image optimisation via
# sharp, and the esbuild-backed dev server all work. Modern sharp and esbuild ship
# prebuilt platform binaries as optional dependencies, so neither needs a
# postinstall step.
#
# The trade-off, stated so it is not a surprise later: if a future dependency
# genuinely needs an install script, it will be skipped silently and the failure
# will surface at runtime rather than at install. The fix then is to allowlist that
# one package (`npm approve-scripts <pkg>`), not to remove this line.
#
# This does not affect `npm run <script>`. Our own scripts still run normally, and
# package.json defines no pre/post lifecycle hooks.
ignore-scripts=true
