{
  "name": "node-red-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "verify:urls": "npx tsx scripts/verify-urls.ts",
    "verify:images": "npx tsx scripts/verify-images.ts",
    "verify:all": "npm run build && npm run verify:urls && npm run verify:images",
    "sync:upstream": "npx tsx scripts/sync-upstream.ts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/starlight": "^0.39.2",
