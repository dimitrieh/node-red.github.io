---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import DownloadHero from '../components/DownloadHero.astro';
import { users } from '../data/users';
import { announcement } from '../data/announcement';
import { getCollection } from 'astro:content';
import { parseBlogPosts, sortBlogPosts, formatBlogDate, blogPostUrl } from '../utils/blog';
import { readFileSync } from 'node:fs';
// Editor illustration — generated from the Figma export by
// `scripts/build-editor-svg.mjs`. The script extracts the two flow nodes
// + wire into a pannable group and injects an SVG <pattern> for the grid
// (the Figma export omits canvas grid because of overflow:hidden). Run
// `node scripts/build-editor-svg.mjs` after re-exporting from Figma.
const editorSvg = readFileSync('./public/images/editor-mock/editor.svg', 'utf8');
// Per-logo tone classification (dark/light/color/boxed) produced by
// scripts/audit-logo-tones.mjs. Drives a per-logo CSS class in the
// trusted-by wall so dark mode can apply targeted treatments rather
// than one filter that breaks half the set. Re-run the script when
// new logos are added to public/users/ and check the file in.
import logoTones from '../data/logo-tones.json';
const logoTone = (logo: string): string => {
  const entry = (logoTones as Record<string, { tone?: string }>)[logo];
  return entry?.tone ?? 'color';
};

// Latest blog posts for the homepage "On the blog" feed.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = sortBlogPosts(parseBlogPosts(allPosts)).slice(0, 5);

// "Who's using Node-RED" — render the full set (matches old Jekyll
// behaviour where every entry in users.yml was rendered). The old site
// also shuffled on page load via inline jQuery; we shuffle once at
// build time using a seeded LCG so the grid stays stable across
// rebuilds from the same source.
let s = users.length;
const lcg = () => {
  s = (s * 1664525 + 1013904223) >>> 0;
  return s / 0x100000000;
};
const shuffledUsers = [...users].sort(() => lcg() - 0.5);

// 47 logos × 6-up is a busy wall. Show the first INITIAL_TRUSTED in the
// baseline view; the rest are rendered in the DOM (so JS-disabled or SEO
// crawlers still see the full list) but hidden via CSS until the user
// expands with the "Show all" toggle. 18 = 3 rows of 6, a clean baseline.
const INITIAL_TRUSTED = 18;

// Get Started platforms — the first INITIAL_PLATFORMS render immediately; the
// rest are present in the DOM but hidden, revealed by the "See all platforms"
// toggle. Each row is a link straight to that platform's guide. It used to be a
// disclosure that opened a panel with an intro line and a one-liner install
// command, which meant two clicks to reach a guide that says the same thing more
// fully, so the panel is gone and the row navigates. URLs match the docs
// structure; keep in sync with docs/getting-started/index.md.
type Platform = { href: string; img: string; name: string; desc: string };

const PLATFORMS: Platform[] = [
  {
    href: '/docs/getting-started/local/',
    img: '/images/platform-local.png',
    name: 'Run locally',
    desc: 'Install Node-RED on your machine with npm.',
  },
  {
    href: '/docs/getting-started/docker/',
    img: '/images/platform-local-docker.png',
    name: 'Docker',
    desc: 'Run in a container for easy deployment.',
  },
  {
    href: '/docs/getting-started/raspberrypi/',
    img: '/images/platform-device-pi.png',
    name: 'Raspberry Pi',
    desc: 'Perfect for IoT and edge computing projects.',
  },
  {
    href: '/docs/getting-started/development/',
    img: '/images/platform-local-dev.png',
    name: 'Install from git',
    desc: 'Build Node-RED from source and start contributing.',
  },
  {
    href: '/docs/getting-started/beaglebone/',
    img: '/images/platform-device.png',
    name: 'BeagleBone',
    desc: 'Run Node-RED on BeagleBone boards.',
  },
  {
    href: '/docs/getting-started/android/',
    img: '/images/platform-android.png',
    name: 'Android',
    desc: 'Experimental — runs on Android via Termux.',
  },
  {
    href: '/docs/getting-started/flowfuse/',
    img: '/images/platform-cloud.png',
    name: 'FlowFuse',
    desc: 'Multi-tenant Node-RED in the cloud.',
  },
  {
    href: '/docs/getting-started/aws/',
    img: '/images/platform-cloud.png',
    name: 'AWS',
    desc: 'Run on Elastic Beanstalk or EC2.',
  },
  {
    href: '/docs/getting-started/azure/',
    img: '/images/platform-cloud.png',
    name: 'Microsoft Azure',
    desc: 'Run on an Azure Virtual Machine.',
  },
];
const INITIAL_PLATFORMS = 3;
---

<BaseLayout title="Home">
  <!-- Hero Section — the interactive editor illustration IS the hero.
       Single inline SVG transcribed from Figma node 5:900 (1390×849).
       Geometry is identical to a Figma SVG export — same coordinates,
       same fills, same strokes. Interactive layer adds:
         · per-element hover highlight + tooltip via [data-label]
         · click-and-drag panning on the canvas content (translates the
           <g class="ed-canvas-pan"> group within a clipPath)
         · an idle ghost cursor that occasionally pans the canvas until
           the first real pointer interaction retires it
       The viewBox does the responsive work — the SVG scales to whatever
       container width is available, preserving the 1390:849 aspect.
       Messaging sits above the drawing as its own block. -->
  <section class="hero-editor">
    <div class="nr-grid">
      <div class="hero-intro nr-col-full">
        <h1 class="hero-title">Programming you can see<span class="hero-accent">.</span></h1>
        <p class="hero-subtitle">
          Node-RED is a visual programming tool for event-driven systems. Wire hardware, APIs, and
          online services into flows you can read at a glance, then deploy with a click.
        </p>
        <div class="hero-actions flex items-center gap-4">
          <a href="#install" class="nr-btn nr-btn-primary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ></path>
            </svg>
            Install
          </a>
          <a href="/docs/" class="nr-btn nr-btn-secondary">
            Documentation
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M1 6h10M7 2l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
      <div class="ed-wrap nr-col-full">
        <div class="ed-stage">
          <Fragment set:html={editorSvg} />
          <div class="ed-ghost-cursor" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path
                d="M4 2l7.07 16.97 2.51-7.39 7.39-2.51L4 2z"
                fill="#111111"
                stroke="#ffffff"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Visual Programming — three benefit columns under the hero
       carrying the visual-programming message in prose. -->
  <section class="section-whyvisual nr-section">
    <div class="nr-grid whyvisual-grid">
      <div class="whyvisual-item nr-colspan-4">
        <h2>See the whole system</h2>
        <p>
          Flows read like diagrams. Every input, transformation, and output sits on one canvas, so
          the logic is its own documentation and the whole team can follow it.
        </p>
      </div>
      <div class="whyvisual-item nr-colspan-4">
        <h2>Change it live</h2>
        <p>
          Edit a node, hit deploy, and watch data move. There is no build step, restart, or release
          pipeline between an idea and seeing it run.
        </p>
      </div>
      <div class="whyvisual-item nr-colspan-4">
        <h2>Build on 5,000+ nodes</h2>
        <p>
          Community nodes wrap the boilerplate for MQTT, HTTP, databases, dashboards, and hardware,
          so wiring replaces plumbing code.
        </p>
      </div>
    </div>
  </section>

  <!-- Install Section — the same download hero as the top of the
       /releases page: latest stable version + npm / Docker / source-zip.
       The hero's primary CTA deep-links here via #install. -->
  <section id="install" class="section-getnodered nr-section">
    <div class="nr-grid">
      <div class="nr-col-full">
        <DownloadHero level={2} heading="Install" />
      </div>
    </div>
  </section>

  <!-- Sponsor Section — FlowFuse
       Nick founded FlowFuse in 2021 to drive Node-RED forward; the
       company underwrites much of the upstream work. This block sits
       directly below Install, so a reader who has just seen how to run
       Node-RED themselves is offered the managed path next.

       Layout: a 12-col card with a soft red-tinted gradient surface so
       it reads as a featured spotlight, not a generic content card.
       Inside, a 4-col logo lockup + 8-col copy/CTA pairing. -->
  <section class="section-sponsor">
    <div class="nr-grid">
      <article class="sponsor-card nr-col-full">
        <div class="sponsor-logo-frame flex flex-col items-center justify-center gap-4 text-center">
          <p class="sponsor-eyebrow">Founding sponsor</p>
          <!-- The mark is a link to flowfuse.com, same as every logo on the
               trusted-by wall. A reader who recognises the mark reaches for it
               before they read down to the CTA button below. -->
          <a href="https://flowfuse.com" target="_blank" rel="noopener" class="sponsor-logo-link">
            <img src="/users/flowfuse.svg" alt="FlowFuse" width="220" height="119" />
          </a>
          <p class="sponsor-since">supporting Node-RED since 2021</p>
        </div>

        <div class="sponsor-body flex flex-col gap-4">
          <h2 class="sponsor-heading">Considering Node-RED for production?</h2>
          <p class="sponsor-tagline">
            <strong class="sponsor-brand">FlowFuse</strong> is the enterprise platform built around Node-RED
            &mdash; by the Node-RED team. It adds authentication, team workspaces, deployment pipelines,
            a hardened runtime and 24/7 support, and is the path most organisations follow when putting
            Node-RED into production at scale.
          </p>
          <div class="sponsor-actions flex flex-wrap items-center gap-5">
            <a
              href="https://flowfuse.com"
              target="_blank"
              rel="noopener"
              class="nr-btn nr-btn-primary sponsor-cta inline-flex items-center gap-2"
            >
              Visit flowfuse.com
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <!-- Straight to the History section, since that is the story this
                 sponsor block refers to. /about/ opens on "About Node-RED" and the
                 reader had to find History themselves. The id comes from the `##
                 History` heading in the about content, and marketing pages already
                 carry scroll-padding-top, so it lands clear of the sticky navbar. -->
            <a href="/about/#history" class="sponsor-cta-secondary"> Read the story </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Platforms Section
       Three platform rows visible by default, all rendered in the DOM.
       Clicking "See all platforms" expands the section to reveal the
       rest in place — same pattern as Trusted By's "Show all" toggle.
       Each row is a subgrid of the section's 12-col rails so icon /
       name / description / arrow align vertically across all rows. -->
  <section class="section-getstarted nr-section">
    <div class="nr-grid">
      <SectionLabel label="Platforms">
        {
          PLATFORMS.length > INITIAL_PLATFORMS && (
            <button
              type="button"
              class="getstarted-all nr-link-btn"
              data-getstarted-toggle
              aria-expanded="false"
              aria-controls="getstarted-row"
            >
              <span data-getstarted-toggle-label>See all platforms &rarr;</span>
            </button>
          )
        }
      </SectionLabel>
      <div id="getstarted-row" class="getstarted-row nr-subgrid" data-getstarted-row>
        {
          PLATFORMS.map((p, i) => (
            <div class:list={['platform-row', i >= INITIAL_PLATFORMS && 'platform-row--extra']}>
              <a href={p.href} class="platform-trigger">
                <span class="platform-icon flex items-center">
                  <img src={p.img} alt="" width="48" height="48" />
                </span>
                <span class="platform-name">{p.name}</span>
                <span class="platform-desc">{p.desc}</span>
                <svg
                  class="platform-toggle"
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2 7h9M8 3.5 11.5 7 8 10.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Trusted By Section
       The logo wall uses a column-subgrid so each logo tile snaps to 2
       of the 12 parent tracks (6-up at desktop). Tiles inherit the same
       gutter rhythm as the rest of the page rather than declaring their
       own grid in isolation. -->
  <section class="section-trusted nr-section nr-raster nr-raster-dots">
    <div class="nr-grid">
      <SectionLabel label="Trusted by">
        {
          shuffledUsers.length > INITIAL_TRUSTED && (
            <button
              type="button"
              class="trusted-toggle nr-link-btn"
              data-trusted-toggle
              aria-expanded="false"
              aria-controls="trusted-grid"
            >
              <span data-trusted-toggle-label>Show all &rarr;</span>
            </button>
          )
        }
      </SectionLabel>
      <div class="trusted-viewport nr-col-full" data-trusted-viewport>
        <div id="trusted-grid" class="trusted-grid" data-trusted-grid>
          {
            shuffledUsers.map((user) => (
              <a
                href={user.url}
                target="_blank"
                rel="noopener"
                class:list={[
                  'trusted-logo nr-colspan-2',
                  `trusted-logo--tone-${logoTone(user.logo)}`,
                ]}
              >
                <img src={`/users/${user.logo}`} alt={user.name} loading="lazy" />
              </a>
            ))
          }
        </div>
      </div>
      <p class="trusted-disclaimer nr-col-full" data-char-stagger>
        {
          (() => {
            // Stripe.dev-style per-character reveal: each non-space char
            // gets its own animatable span with a global incrementing
            // delay index. Words are wrapped in nowrap containers so the
            // character spans don't break mid-word at line ends.
            const text =
              'All logos used with permission. These links do not constitute an endorsement or approval by the Node-RED project of any of the products, services or opinions of the companies listed.';
            let charIndex = 0;
            return text.split(' ').map((word, w, words) => (
              <>
                <span class="trusted-disclaimer-word">
                  {[...word].map((char) => {
                    const i = charIndex++;
                    return (
                      <span class="trusted-disclaimer-char" style={`--char-i: ${i}`}>
                        {char}
                      </span>
                    );
                  })}
                </span>
                {w < words.length - 1 ? ' ' : ''}
              </>
            ));
          })()
        }
      </p>
      <p class="trusted-feature-link nr-col-full" id="trusted-feature-link">
        <a class="trusted-info" href="/about/community/">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          Want to feature your product here?
        </a>
      </p>
    </div>
  </section>

  <!-- On the blog (latest posts) — restored from the old Jekyll
       homepage where it shared a row with the Community section.
       Each post row uses a column-subgrid so the date column lines up
       on track 1-3 and the title on tracks 4-12, matching the rhythm
       of the rest of the page rather than its own arbitrary `180px 1fr`. -->
  <section class="section-blog nr-section">
    <div class="nr-grid">
      <SectionLabel label="On the blog">
        <a href="/blog/" class="blog-feed-more nr-section-link">All posts &rarr;</a>
      </SectionLabel>
      <ul class="blog-feed-list nr-feed-list nr-col-full">
        {
          latestPosts.map((post) => (
            <li class="blog-feed-item nr-feed-item">
              <a href={blogPostUrl(post)} class="blog-feed-link nr-feed-link">
                <time datetime={post.date.toISOString()} class="blog-feed-date nr-feed-date-col">
                  {formatBlogDate(post.date)}
                </time>
                <span class="blog-feed-title">{post.data.title}</span>
                <span class="blog-feed-cta nr-feed-cta-col" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- On the forum (Discourse weekly highlights, diversified)
       Mirrors .blog-feed-* row pattern. The server renders skeleton
       placeholders so initial paint has no layout shift; a client-side
       <script> fetches /top.json?period=weekly + /categories.json,
       runs a soft-cap diversification pass (1 thread per category,
       relaxed to 2 then unlimited only if the floor of 5 isn't met),
       and shows up to 8 rows with a category chip on each.

       CORS note: discourse.nodered.org currently emits no
       Access-Control-Allow-Origin header for this site's origin, so
       the live fetch will be blocked in production until either
         (a) DISCOURSE_CORS_ORIGINS on the Discourse instance is
             updated to include https://nodered.org, OR
         (b) a small proxy (Cloudflare Worker / Netlify Function) is
             put in front and the *_API constants below are pointed
             at it.
       In dev, the Astro/Vite server proxies /_forum-proxy/* to
       Discourse (see astro.config.mjs), so the live data renders.
       On any error the catch-block falls back to a single
       "Browse the forum" link so the section degrades cleanly. -->
  <section class="section-forum nr-section">
    <div class="nr-grid">
      <SectionLabel label="On the forum">
        <a
          href="https://discourse.nodered.org/latest"
          class="forum-feed-more nr-section-link"
          target="_blank"
          rel="noopener"
        >
          All threads &rarr;
        </a>
      </SectionLabel>
      <ul
        class="forum-feed-list nr-feed-list nr-col-full"
        data-forum-feed
        aria-busy="true"
        aria-live="polite"
      >
        {
          Array.from({ length: 5 }).map(() => (
            <li class="forum-feed-item nr-feed-item forum-feed-skeleton" aria-hidden="true">
              <span class="forum-feed-link nr-feed-link">
                <span class="forum-feed-date nr-feed-date-col">&nbsp;</span>
                <span class="forum-feed-title">
                  <span class="skeleton-bar" />
                </span>
                <span class="forum-feed-cta nr-feed-cta-col" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </li>
          ))
        }
      </ul>
      <noscript>
        <p class="forum-feed-fallback">
          <a href="https://discourse.nodered.org/latest"
            >Browse the latest discussions on the forum &rarr;</a
          >
        </p>
      </noscript>
    </div>
  </section>

  <!-- Open source (GitHub stats + contributor avatar wall)
       Centred eyebrow / headline / tagline / 4 stat numbers, with a
       grid of real contributor avatars from node-red/node-red as a
       backdrop. Avatars are desaturated + low-opacity + radial-vignette
       masked so the centre of the card stays legible for the numbers.
       Stats fetched client-side from api.github.com (public CORS — no
       proxy needed, unlike Discourse): orgs/node-red/repos for stars +
       forks, repos/node-red/node-red/contributors for the count + the
       avatars, search/issues for PRs-merged-last-month. -->
  <section class="section-oss nr-section">
    <div class="nr-grid">
      <SectionLabel label="Open source">
        <button
          type="button"
          class="oss-toggle nr-link-btn"
          data-oss-toggle
          aria-expanded="false"
          aria-controls="data-oss-avatars"
          hidden
        >
          <span data-oss-toggle-label>Show all contributors →</span>
        </button>
      </SectionLabel>
      <ul class="oss-stat-row nr-col-full">
        <li class="oss-stat">
          <span class="oss-stat-num" data-oss-stat="years">—</span>
          <span class="oss-stat-label">Years on GitHub</span>
        </li>
        <li class="oss-stat">
          <span class="oss-stat-num" data-oss-stat="stars">—</span>
          <span class="oss-stat-label">Stars</span>
        </li>
        <li class="oss-stat">
          <span class="oss-stat-num" data-oss-stat="forks">—</span>
          <span class="oss-stat-label">Forks</span>
        </li>
        <li class="oss-stat">
          <span class="oss-stat-num" data-oss-stat="contributors">—</span>
          <span class="oss-stat-label">Contributors</span>
        </li>
        <li class="oss-stat">
          <span class="oss-stat-num" data-oss-stat="prs">—</span>
          <span class="oss-stat-label">PRs merged last month</span>
        </li>
      </ul>
      <!-- Avatar wall: same tile rhythm as `.trusted-grid` — sharp
           square cells, hairline borders, no rounded corners. Clipped
           to N rows by .oss-avatar-viewport; the grid auto-rotates one
           row at a time on a slow timer so a new band of contributors
           drifts in every ~10s.

           Skeleton-first: we server-render 48 placeholder tiles so the
           lattice + a band of pulsing circles is visible before the
           client fetch resolves, and stays visible if it fails (e.g.
           GitHub rate-limit). On success the loader REPLACES this set
           with real anchor tiles. Mirrors the forum/issues feed
           skeleton-row pattern. -->
      <div class="oss-avatar-viewport nr-col-full" data-oss-viewport>
        {
          /*
            No `aria-hidden` on this container. The loader replaces the
            skeleton with real anchor tiles and gives each one an
            `aria-label` of "@login on GitHub" precisely so screen readers
            announce the contributor; hiding the container cancelled every
            one of those labels while leaving the anchors keyboard-focusable,
            which is the aria-hidden-focus violation axe reports. The
            skeleton tiles below carry their own `aria-hidden`, so the
            pre-load state stays silent without it.
        */
        }
        <div class="oss-avatar-grid" data-oss-avatars>
          {
            Array.from({ length: 48 }).map(() => (
              <div class="oss-avatar-tile oss-avatar-tile--skeleton" aria-hidden="true">
                <span class="oss-avatar-skel" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Top GitHub issues (live feed)
       Mirrors the .forum-feed-* visual rhythm exactly — same subgrid
       row, same date column, same chip pattern, same skeleton, same
       fallback. Endpoint: api.github.com/search/issues sorted by
       recently-updated, scoped to the whole node-red org. Diversified
       by repo (same soft-cap algorithm as forum: 1 → 2 → uncapped). -->
  <section class="section-issues nr-section">
    <div class="nr-grid">
      <SectionLabel label="Top issues this week">
        <a
          href="https://github.com/issues?q=org%3Anode-red+is%3Aissue+is%3Aopen+sort%3Aupdated-desc"
          class="forum-feed-more nr-section-link"
          target="_blank"
          rel="noopener"
        >
          All issues &rarr;
        </a>
      </SectionLabel>
      <ul
        class="forum-feed-list nr-feed-list nr-col-full"
        data-issues-feed
        aria-busy="true"
        aria-live="polite"
      >
        {
          Array.from({ length: 5 }).map(() => (
            <li class="forum-feed-item nr-feed-item forum-feed-skeleton" aria-hidden="true">
              <span class="forum-feed-link nr-feed-link">
                <span class="forum-feed-date nr-feed-date-col">&nbsp;</span>
                <span class="forum-feed-title">
                  <span class="skeleton-bar" />
                </span>
                <span class="forum-feed-cta nr-feed-cta-col" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </li>
          ))
        }
      </ul>
      <noscript>
        <p class="forum-feed-fallback">
          <a href="https://github.com/node-red/node-red/issues"
            >Browse open issues on GitHub &rarr;</a
