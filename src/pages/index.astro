---
import BaseLayout from '../layouts/BaseLayout.astro';
import { users } from '../data/users';
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="hero nr-raster nr-raster-hero">
    <div class="hero-grid nr-grid">
      <div class="hero-content">
        <p class="hero-eyebrow">
          <span class="eyebrow-slash">/</span> Open Source
          <span class="eyebrow-dot">&middot;</span> Event-Driven
        </p>
        <h1 class="hero-title">
          Wire anything<span class="hero-accent">.</span><br />
          <span class="hero-accent">Flow</span> everything<span class="hero-accent">.</span>
        </h1>
        <p class="hero-subtitle">
          Node-RED is a low-code programming tool for wiring together
          hardware devices, APIs, and online services — with a browser-based
          visual editor and a lightweight Node.js runtime.
        </p>
        <div class="hero-actions">
          <a href="/docs/getting-started/" class="nr-btn nr-btn-primary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Get Started
          </a>
          <a href="/docs/" class="nr-btn nr-btn-secondary">
            Documentation
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M1 6h10M7 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="video-wrap">
          <iframe
            src="https://www.youtube.com/embed/ksGeUD26Mw0"
            title="Introduction - Node-RED Essentials"
            width="560"
            height="315"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section-features nr-raster nr-raster-subtle">
    <div class="nr-grid">
      <div class="nr-label nr-col-full">
        <span class="nr-label-marker">/</span> Features
      </div>
      <div class="features-row nr-col-full">
        <article class="feature-card nr-card">
          <div class="feature-icon-wrap">
            <img src="/images/nr-image-1.png" alt="" width="48" height="48" />
          </div>
          <h2 class="feature-title">Browser-based flow editing</h2>
          <p class="feature-text">
            A powerful visual editor in the browser — drag, drop, and wire nodes
            together. Deploy flows to the runtime in a single click.
          </p>
        </article>
        <article class="feature-card nr-card">
          <div class="feature-icon-wrap">
            <img src="/images/nr-image-2.png" alt="" width="48" height="48" />
          </div>
          <h2 class="feature-title">Built on Node.js</h2>
          <p class="feature-text">
            A lightweight, event-driven runtime that's perfect for running at the
            edge on low-cost hardware or scaled up in the cloud.
          </p>
        </article>
        <article class="feature-card nr-card">
          <div class="feature-icon-wrap">
            <img src="/images/nr-image-3.png" alt="" width="48" height="48" />
          </div>
          <h2 class="feature-title">Social Development</h2>
          <p class="feature-text">
            Flows stored as JSON are easy to version, share, and import. Browse the
            online flow library for community-contributed solutions.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Get Started Section -->
  <section class="section-getstarted">
    <div class="nr-grid">
      <div class="nr-label nr-col-full">
        <span class="nr-label-marker">/</span> Get Started
      </div>
      <div class="getstarted-row nr-col-full">
        <a href="/docs/getting-started/local/" class="platform-card">
          <div class="platform-icon">
            <img src="/images/platform-local.png" alt="" width="48" height="48" />
          </div>
          <div class="platform-info">
            <h3 class="platform-name">Run locally</h3>
            <p class="platform-desc">Install Node-RED on your machine with npm.</p>
          </div>
          <svg class="platform-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/docs/getting-started/docker/" class="platform-card">
          <div class="platform-icon">
            <img src="/images/platform-local-docker.png" alt="" width="48" height="48" />
          </div>
          <div class="platform-info">
            <h3 class="platform-name">Docker</h3>
            <p class="platform-desc">Run in a container for easy deployment.</p>
          </div>
          <svg class="platform-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/docs/getting-started/raspberrypi/" class="platform-card">
          <div class="platform-icon">
            <img src="/images/platform-device-pi.png" alt="" width="48" height="48" />
          </div>
          <div class="platform-info">
            <h3 class="platform-name">Raspberry Pi</h3>
            <p class="platform-desc">Perfect for IoT and edge computing projects.</p>
          </div>
          <svg class="platform-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trusted By Section -->
  <section class="section-trusted nr-raster nr-raster-dots">
    <div class="nr-grid">
      <div class="nr-label nr-col-full">
        <span class="nr-label-marker">/</span> Trusted by
      </div>
      <div class="trusted-grid nr-col-full">
        {users.slice(0, 12).map((user) => (
          <a href={user.url} target="_blank" rel="noopener" class="trusted-logo">
            <img src={`/users/${user.logo}`} alt={user.name} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Community Section -->
  <section class="section-community">
    <div class="nr-grid">
      <div class="nr-label nr-col-full">
        <span class="nr-label-marker">/</span> Community
      </div>
      <div class="community-row nr-col-full">
        <a href="https://discourse.nodered.org" class="community-card nr-card" target="_blank" rel="noopener">
          <div class="community-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="community-name">Forum</h3>
          <p class="community-desc">Get help, share ideas and discuss Node-RED with the community.</p>
        </a>
        <a href="/about/community/slack/" class="community-card nr-card">
          <div class="community-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="9" y="2" width="6" height="8" rx="3" stroke="currentColor" stroke-width="1.5"/>
              <rect x="2" y="9" width="8" height="6" rx="3" stroke="currentColor" stroke-width="1.5"/>
              <rect x="9" y="14" width="6" height="8" rx="3" stroke="currentColor" stroke-width="1.5"/>
              <rect x="14" y="9" width="8" height="6" rx="3" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <h3 class="community-name">Slack</h3>
          <p class="community-desc">Join the workspace for real-time chat with developers.</p>
        </a>
        <a href="https://github.com/node-red" class="community-card nr-card" target="_blank" rel="noopener">
          <div class="community-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
          </div>
          <h3 class="community-name">GitHub</h3>
          <p class="community-desc">Contribute to the project or report issues.</p>
        </a>
        <a href="https://flows.nodered.org" class="community-card nr-card" target="_blank" rel="noopener">
          <div class="community-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="community-name">Flow Library</h3>
          <p class="community-desc">Discover and share flows, nodes, and collections.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===================================================================
     HERO SECTION
     =================================================================== */
  .hero {
    padding: var(--space-10) 0 var(--space-9);
    background: var(--nr-gray-50);
  }

  .hero-grid {
    align-items: center;
  }

  .hero-content {
    grid-column: 1 / 7;
    position: relative;
    z-index: 1;
  }

  .hero-visual {
    grid-column: 7 / -1;
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-overline);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--nr-red);
    margin-bottom: var(--space-5);
    font-weight: 500;
  }

  .eyebrow-slash {
    opacity: 0.5;
    margin-right: 4px;
  }

  .eyebrow-dot {
    margin: 0 6px;
    opacity: 0.4;
  }

  .hero-title {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--nr-black);
    margin-bottom: var(--space-5);
  }

  .hero-accent {
    color: var(--nr-red);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--nr-gray-700);
    max-width: 520px;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .video-wrap {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ===================================================================
     FEATURES SECTION
     =================================================================== */
  .section-features {
    padding: var(--space-9) 0;
    background: var(--nr-white);
  }

  .features-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .feature-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  .feature-icon-wrap {
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--nr-red-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-2);
  }

  .feature-icon-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .feature-title {
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--nr-black);
    margin-bottom: var(--space-3);
    letter-spacing: -0.015em;
  }

  .feature-text {
    font-size: var(--text-body-sm);
    line-height: 1.7;
    color: var(--nr-gray-700);
    margin: 0;
  }

  /* ===================================================================
     GET STARTED SECTION
     =================================================================== */
  .section-getstarted {
    padding: var(--space-9) 0;
    background: var(--nr-gray-50);
  }

  .getstarted-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .platform-card {
    display: grid;
    grid-template-columns: 52px 1fr 20px;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-md);
    border: 1.5px solid var(--nr-gray-200);
    background: var(--nr-white);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard);
  }

  .platform-card:hover {
    border-color: rgba(199, 80, 80, 0.4);
    box-shadow: 0 4px 20px rgba(199, 80, 80, 0.1);
    transform: translateY(-2px);
    text-decoration: none;
    color: inherit;
  }

  .platform-card:hover .platform-arrow {
    color: var(--nr-red);
    transform: translateX(3px);
  }

  .platform-icon {
    width: 52px;
    height: 52px;
  }

  .platform-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .platform-name {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--nr-black);
    margin-bottom: 2px;
    letter-spacing: -0.01em;
  }

  .platform-desc {
    font-size: var(--text-caption);
    color: var(--nr-gray-500);
    margin: 0;
  }

  .platform-arrow {
    color: var(--nr-gray-300);
    transition:
      color var(--duration-fast),
      transform var(--duration-fast);
  }

  /* ===================================================================
     TRUSTED BY SECTION
     =================================================================== */
  .section-trusted {
    padding: var(--space-9) 0;
    background: var(--nr-white);
  }

  .trusted-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
  }

  .trusted-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
    min-height: 80px;
    border-radius: var(--radius-md);
    border: 1px solid var(--nr-gray-200);
    background: var(--nr-gray-50);
    transition:
      border-color var(--duration-fast),
      background var(--duration-fast),
      box-shadow var(--duration-fast),
      transform var(--duration-fast);
    text-decoration: none;
  }

  .trusted-logo:hover {
    border-color: var(--nr-gray-300);
    background: var(--nr-white);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .trusted-logo img {
    max-width: 100%;
    max-height: 36px;
    object-fit: contain;
    opacity: 0.6;
    filter: grayscale(0.4);
    transition:
      opacity var(--duration-fast),
      filter var(--duration-fast);
  }

  .trusted-logo:hover img {
    opacity: 1;
    filter: grayscale(0);
  }

  /* ===================================================================
     COMMUNITY SECTION
     =================================================================== */
  .section-community {
    padding: var(--space-9) 0 var(--space-10);
    background: var(--nr-gray-50);
  }

  .community-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .community-card {
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .community-card:hover {
    text-decoration: none;
    color: inherit;
  }

  .community-card:hover .community-icon {
    color: var(--nr-red);
    background: var(--nr-red-subtle);
  }

  .community-icon {
    color: var(--nr-gray-500);
    margin-bottom: var(--space-5);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-fast),
      background var(--duration-fast);
  }

  .community-name {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--nr-black);
    margin-bottom: var(--space-2);
    letter-spacing: -0.01em;
  }

  .community-desc {
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--nr-gray-500);
    margin: 0;
  }

  /* ===================================================================
     RESPONSIVE
     =================================================================== */
  @media (max-width: 1023px) {
    .hero {
      padding: var(--space-8) 0 var(--space-7);
    }

    .hero-content {
      grid-column: 1 / -1;
    }

    .hero-visual {
      grid-column: 1 / -1;
    }

    .features-row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .getstarted-row {
      grid-template-columns: 1fr;
    }

    .trusted-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .community-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding: var(--space-7) 0 var(--space-7);
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .section-features,
    .section-getstarted,
    .section-trusted,
    .section-community {
      padding: var(--space-7) 0;
    }

    .platform-card {
      grid-template-columns: 44px 1fr 16px;
      padding: var(--space-4) var(--space-5);
    }

    .trusted-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .community-row {
      grid-template-columns: 1fr;
    }

    .community-card {
      padding: var(--space-5);
    }

    .feature-card {
      padding: var(--space-5);
    }
  }
</style>
