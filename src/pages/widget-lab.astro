---

<BaseLayout
  title="Widget lab"
  description="Internal harness for the dependency-free Node-RED editor widget illustrations used in the docs."
  noindex
>
  <DocsWidgets />

  <div class="lab">
    <header class="lab-head">
      <h1>Widget lab</h1>
      <p>
        Every configuration of <code>&lt;nr-typed-input&gt;</code> and
        <code>&lt;nr-auto-complete&gt;</code> that the three widget documentation pages need. Each demo
        is driven by the same config object the docs page passes, printed above it.
      </p>
      <p class="lab-note">
        Internal harness. Not linked from the site navigation, and awaiting a decision on whether it
        stays.
      </p>
    </header>

    <section aria-labelledby="lab-ti">
      <h2 id="lab-ti">typedInput</h2>
      {
        typedInputCases.map((testCase) => (
          <article class="case" id={testCase.id}>
            <h3>{testCase.heading}</h3>
            <p class="case-source">{testCase.source}</p>
            <pre class="case-config">{JSON.stringify(testCase.config, null, 2)}</pre>
            <div class="nr-widget-demo">
              <nr-typed-input
                config={JSON.stringify(testCase.config)}
                value={testCase.value}
                aria-label={testCase.heading}
                data-case={testCase.id}
              />
            </div>
            <p class="case-state" data-state-for={testCase.id}>
              type: <span data-state-type>-</span>, value: <span data-state-value>-</span>
            </p>
          </article>
        ))
      }
    </section>

    <section aria-labelledby="lab-ac">
      <h2 id="lab-ac">autoComplete</h2>
      {
        autoCompleteCases.map((testCase) => (
          <article class="case" id={testCase.id}>
            <h3>{testCase.heading}</h3>
            <p class="case-source">{testCase.source}</p>
            <pre class="case-config">
              {JSON.stringify({ ...testCase.config, source: ['... animals ...'] }, null, 2)}
            </pre>
            <div class="nr-widget-demo">
              <p>Pick an animal</p>
              <nr-auto-complete
                config={JSON.stringify(testCase.config)}
                aria-label={testCase.heading}
                data-case={testCase.id}
              />
            </div>
            <p class="case-state" data-state-for={testCase.id}>
              value: <span data-state-value>-</span>
            </p>
          </article>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .lab {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-6) var(--grid-padding) var(--space-9);
    color: var(--nr-text-body);
  }

  .lab-head h1 {
    font-size: var(--text-h1);
    margin: 0 0 var(--space-3);
  }

  .lab-note {
    border-left: 3px solid var(--nr-red);
    padding-left: var(--space-3);
    color: var(--nr-text-muted);
    font-size: var(--text-body-sm);
  }

  h2 {
    font-size: var(--text-h2);
    margin: var(--space-8) 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--nr-border);
  }

  .case {
    margin-bottom: var(--space-7);
  }

  .case h3 {
    font-size: var(--text-h4);
    margin: 0 0 var(--space-1);
  }

  .case-source {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--nr-text-faint);
  }

  .case-config {
    margin: var(--space-3) 0 0;
    padding: var(--space-3);
    overflow-x: auto;
    background: var(--nr-surface-alt);
    border: 1px solid var(--nr-border);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--nr-text-body);
  }

  .case-state {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--nr-text-muted);
  }
</style>

<script>
  /* Harness wiring only: mirror each element's change event into the readout
     under it. Uses the same createElement/textContent discipline as the rest of
     the site, which matters here because the values come from the widgets. */
  for (const el of document.querySelectorAll('[data-case]')) {
    const caseId = el.getAttribute('data-case');
    const readout = document.querySelector(`[data-state-for="${caseId}"]`);
    if (!readout) continue;
    const typeOut = readout.querySelector('[data-state-type]');
    const valueOut = readout.querySelector('[data-state-value]');
    const paint = (detail: { type?: string | undefined; value?: string | undefined }) => {
      if (typeOut) typeOut.textContent = detail.type ?? '-';
      if (valueOut) valueOut.textContent = detail.value === '' ? '(empty)' : (detail.value ?? '-');
    };
    el.addEventListener('change', (evt) => paint((evt as CustomEvent).detail ?? {}));
    paint({
      type: (el as HTMLElement & { type?: string }).type,
      value: (el as HTMLElement & { value?: string }).value,
    });
  }
</script>
