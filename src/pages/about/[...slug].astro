---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const aboutPages = await getCollection('about');

  return aboutPages
    .filter((page) => page.id !== 'index.md' && page.id !== 'index')
    .map((page) => {
      let slug = page.id
        .replace(/\/index\.md$/, '')
        .replace(/\.md$/, '')
        .replace(/\/index$/, '');
      return {
        params: { slug },
        props: { page },
      };
    });
}

const { page } = Astro.props;
const { Content } = await render(page);

const slugParts = Astro.params.slug?.split('/') || [];

const sidebarLinks = [
  { href: '/about/', label: 'About Node-RED', match: null },
  { href: '/about/community/', label: 'Community', match: 'community' },
  { href: '/about/contribute/', label: 'Contribute', match: 'contribute' },
  { href: '/about/governance/', label: 'Governance', match: 'governance' },
  { href: '/about/license/', label: 'License', match: 'license' },
  { href: '/about/releases/', label: 'Releases', match: 'releases' },
  { href: '/about/conduct/', label: 'Code of Conduct', match: 'conduct' },
  { href: '/about/resources/', label: 'Resources', match: 'resources' },
];
---

<BaseLayout title={page.data.title}>
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href="/">Node-RED</a></li>
      <li><a href="/about/">About</a></li>
      {slugParts.map((part, i) => (
        <li>
          {i === slugParts.length - 1 ? (
            <span aria-current="page">{part}</span>
          ) : (
            <a href={`/about/${slugParts.slice(0, i + 1).join('/')}/`}>{part}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <div class="about-layout">
    <aside class="about-sidebar">
      <nav aria-label="About section">
        <ul class="sidebar-nav">
          {sidebarLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'sidebar-link',
                  { 'is-active': link.match && Astro.params.slug?.startsWith(link.match) }
                ]}
                {...(link.match && Astro.params.slug?.startsWith(link.match) ? { 'aria-current': 'page' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <div class="about-content">
      <h1>{page.data.title}</h1>
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb-bar {
    background: var(--nr-red);
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: 0 var(--grid-padding);
  }

  .breadcrumb-list {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    width: 100%;
    display: flex;
    list-style: none;
    gap: 0;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
  }

  .breadcrumb-list li {
    display: flex;
    align-items: center;
  }

  .breadcrumb-list li::before {
    content: '/';
    color: rgba(255, 255, 255, 0.5);
    margin: 0 10px;
  }

  .breadcrumb-list li:first-child::before {
    content: '';
    margin: 0;
  }

  .breadcrumb-list a,
  .breadcrumb-list span {
    color: white;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .breadcrumb-list a:hover {
    text-decoration: underline;
    color: white;
  }

  /* ── Layout ── */
  .about-layout {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    padding: var(--space-6) var(--grid-padding) var(--space-8);
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-7);
  }

  /* ── Sidebar ── */
  .about-sidebar {
    position: sticky;
    top: 80px;
    align-self: start;
  }

  .sidebar-nav {
    list-style: none;
  }

  .sidebar-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    color: var(--nr-gray-700);
    font-size: var(--text-body-sm);
    font-family: var(--font-sans);
    text-decoration: none;
    border-left: 3px solid var(--nr-gray-200);
    letter-spacing: -0.01em;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  .sidebar-link:hover {
    border-left-color: var(--nr-red);
    color: var(--nr-black);
    background: rgba(199, 80, 80, 0.04);
    text-decoration: none;
  }

  .sidebar-link.is-active {
    border-left-color: var(--nr-red);
    color: var(--nr-red);
    font-weight: 600;
    background: rgba(199, 80, 80, 0.06);
  }

  /* ── Content ── */
  .about-content {
    background: var(--nr-white);
    padding: var(--space-7) var(--space-8);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--nr-gray-200);
  }

  .about-content :global(h1) {
    font-size: var(--text-h1);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 3px solid var(--nr-red);
    letter-spacing: -0.025em;
  }

  .about-content :global(h2) {
    font-size: var(--text-h2);
    margin: var(--space-6) 0 var(--space-4);
    letter-spacing: -0.02em;
  }

  .about-content :global(h3) {
    font-size: var(--text-h3);
    margin: var(--space-5) 0 var(--space-3);
    letter-spacing: -0.015em;
  }

  .about-content :global(p) {
    margin: var(--space-4) 0;
    line-height: 1.7;
  }

  .about-content :global(ul),
  .about-content :global(ol) {
    margin: var(--space-4) 0;
    padding-left: 28px;
  }

  .about-content :global(li) {
    margin: var(--space-2) 0;
  }

  .about-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .about-content :global(.grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin: var(--space-5) 0;
    align-items: center;
  }

  .about-content :global(.col-1-2) {
    min-width: 0;
  }

  .about-content :global(.doc-callout) {
    background: var(--nr-red-light);
    border-left: 4px solid var(--nr-red);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-5) 0;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--nr-gray-700);
  }

  .about-content :global(iframe) {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: var(--space-5) 0;
  }

  @media (max-width: 767px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .about-sidebar {
      position: static;
      order: 2;
    }

    .about-content {
      padding: var(--space-5);
    }

    .about-content :global(.grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
