---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { parseBlogPosts, sortBlogPosts, formatBlogDate, blogPostUrl } from '../../utils/blog';

const posts = await getCollection('blog');
const sortedPosts = sortBlogPosts(parseBlogPosts(posts));

// Paginate - first page shows 9 posts
const pageSize = 9;
const firstPagePosts = sortedPosts.slice(0, pageSize);
const totalPages = Math.ceil(sortedPosts.length / pageSize);
---

<BaseLayout title="Blog">
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href="/">Node-RED</a></li>
      <li><span aria-current="page">Blog</span></li>
    </ol>
  </nav>

  <div class="blog-container">
    <h1 class="blog-heading">Blog</h1>

    <div class="blog-grid">
      {firstPagePosts.map((post, i) => (
        <article class:list={['blog-card', { 'blog-card-featured': i === 0 }]}>
          <a href={blogPostUrl(post)} class="blog-card-link">
            <time datetime={post.date.toISOString()} class="blog-card-date">{formatBlogDate(post.date)}</time>
            <h2 class="blog-card-title">{post.data.title}</h2>
            {post.data.description && <p class="blog-card-excerpt">{post.data.description}</p>}
            <span class="blog-card-cta" aria-hidden="true">
              Read post
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M1 6h10M7 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </article>
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="blog-pagination">
        <span class="pagination-info">Page 1 of {totalPages}</span>
        <a href="/blog/page/2/" class="nr-btn nr-btn-primary">Older posts &rarr;</a>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  /* Breadcrumb bar styles live in BaseLayout (global) to keep parity
     across blog/about/blogpost. */

  .blog-container {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    padding: var(--space-6) var(--grid-padding) var(--space-8);
  }

  .blog-heading {
    font-size: var(--text-h1);
    color: var(--nr-text-strong);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 3px solid var(--nr-red);
    letter-spacing: -0.025em;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-5);
  }

  .blog-card {
    background: var(--nr-surface-elevated);
    border: 1px solid var(--nr-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard);
    position: relative;
    overflow: hidden;
  }

  .blog-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--nr-red);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--duration-normal) var(--ease-standard);
  }

  .blog-card:hover {
    border-color: rgba(199, 80, 80, 0.35);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .blog-card:hover::before {
    transform: scaleY(1);
    transform-origin: top;
  }

  .blog-card-featured {
    grid-column: 1 / -1;
    background: var(--nr-red-light);
    border-color: rgba(199, 80, 80, 0.25);
  }

  :root[data-theme='dark'] .blog-card-featured {
    background: rgba(199, 80, 80, 0.10);
  }

  .blog-card-featured::before {
    transform: scaleY(1);
    transform-origin: top;
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .blog-card-link:hover {
    text-decoration: none;
    color: inherit;
  }

  .blog-card-date {
    display: block;
    font-size: var(--text-overline);
    color: var(--nr-text-faint);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .blog-card-title {
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--nr-text-strong);
    margin-bottom: var(--space-3);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .blog-card-featured .blog-card-title {
    font-size: var(--text-h2);
    letter-spacing: -0.02em;
    max-width: 60ch;
  }

  .blog-card-excerpt {
    font-size: var(--text-body-sm);
    color: var(--nr-text-muted);
    line-height: 1.65;
    margin: 0 0 var(--space-5);
    flex: 1;
  }

  .blog-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--nr-red);
    margin-top: auto;
    transition: gap var(--duration-fast) var(--ease-standard);
  }

  .blog-card:hover .blog-card-cta {
    gap: 10px;
  }

  .blog-card-cta svg {
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .blog-pagination {
    margin-top: var(--space-7);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-5);
    border-top: 1px solid var(--nr-border);
    gap: var(--space-4);
  }

  .pagination-info {
    color: var(--nr-text-faint);
    font-size: var(--text-caption);
    font-family: var(--font-mono);
  }

  @media (max-width: 767px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-card-featured {
      grid-column: auto;
    }
  }
</style>
