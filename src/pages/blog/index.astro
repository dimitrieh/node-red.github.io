---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { parseBlogPosts, sortBlogPosts, formatBlogDate, blogPostUrl } from '../../utils/blog';

const posts = await getCollection('blog');
const sortedPosts = sortBlogPosts(parseBlogPosts(posts));

// Paginate - first page shows 9 posts
const pageSize = 9;
const firstPagePosts = sortedPosts.slice(0, pageSize);
const totalPages = Math.ceil(sortedPosts.length / pageSize);
---

<BaseLayout title="Blog">
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href="/">Node-RED</a></li>
      <li><span aria-current="page">Blog</span></li>
    </ol>
  </nav>

  <div class="blog-container">
    <h1 class="blog-heading">Blog</h1>

    <div class="blog-grid">
      {firstPagePosts.map((post, i) => (
        <article class:list={['blog-card', { 'blog-card-featured': i === 0 }]}>
          <a href={blogPostUrl(post)} class="blog-card-link">
            <h2 class="blog-card-title">{post.data.title}</h2>
            <time datetime={post.date.toISOString()} class="blog-card-date">{formatBlogDate(post.date)}</time>
            {post.data.description && <p class="blog-card-excerpt">{post.data.description}</p>}
          </a>
        </article>
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="blog-pagination">
        <span class="pagination-info">Page 1 of {totalPages}</span>
        <a href="/blog/page/2/" class="nr-btn nr-btn-primary">Older posts &rarr;</a>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .breadcrumb-bar {
    background: var(--nr-red);
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: 0 var(--grid-padding);
  }

  .breadcrumb-list {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    width: 100%;
    display: flex;
    list-style: none;
    gap: 0;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
  }

  .breadcrumb-list li {
    display: flex;
    align-items: center;
  }

  .breadcrumb-list li::before {
    content: '/';
    color: rgba(255, 255, 255, 0.5);
    margin: 0 10px;
  }

  .breadcrumb-list li:first-child::before {
    content: '';
    margin: 0;
  }

  .breadcrumb-list a,
  .breadcrumb-list span {
    color: white;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .breadcrumb-list a:hover {
    text-decoration: underline;
    color: white;
  }

  .blog-container {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    padding: var(--space-6) var(--grid-padding) var(--space-8);
  }

  .blog-heading {
    font-size: var(--text-h1);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 3px solid var(--nr-red);
    letter-spacing: -0.025em;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-5);
  }

  .blog-card {
    background: var(--nr-white);
    border: 1px solid var(--nr-gray-200);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard);
  }

  .blog-card:hover {
    border-color: rgba(199, 80, 80, 0.3);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .blog-card-featured {
    grid-column: 1 / -1;
    background: var(--nr-gray-50);
    border-color: rgba(199, 80, 80, 0.15);
  }

  .blog-card-link {
    display: block;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .blog-card-link:hover {
    text-decoration: none;
    color: inherit;
  }

  .blog-card-title {
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--nr-black);
    margin-bottom: var(--space-2);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .blog-card-featured .blog-card-title {
    font-size: var(--text-h2);
    letter-spacing: -0.02em;
  }

  .blog-card-date {
    display: block;
    font-size: var(--text-caption);
    color: var(--nr-gray-500);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .blog-card-excerpt {
    font-size: var(--text-body-sm);
    color: var(--nr-gray-700);
    line-height: 1.6;
    margin: 0;
  }

  .blog-pagination {
    margin-top: var(--space-7);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-5);
    border-top: 1px solid var(--nr-gray-200);
  }

  .pagination-info {
    color: var(--nr-gray-500);
    font-size: var(--text-caption);
    font-family: var(--font-mono);
  }

  @media (max-width: 767px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-card-featured {
      grid-column: auto;
    }
  }
</style>
