---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { parseBlogPosts, sortBlogPosts, formatBlogDate, blogPostUrl } from '../../utils/blog';

const posts = await getCollection('blog');
const sortedPosts = sortBlogPosts(parseBlogPosts(posts));

// Paginate - first page shows 9 posts
const pageSize = 9;
const firstPagePosts = sortedPosts.slice(0, pageSize);
const totalPages = Math.ceil(sortedPosts.length / pageSize);
---

<BaseLayout title="Blog" vtAnchor="#nr-vt-band">
  <div class="blog-container">
    <h1 class="nr-page-heading text-[var(--text-h1)]">Blog</h1>

    <div class="blog-grid">
      {
        firstPagePosts.map((post, i) => (
          <article class:list={['blog-card', { 'blog-card-featured': i === 0 }]}>
            <a href={blogPostUrl(post)} class="blog-card-link flex flex-col">
              <time datetime={post.date.toISOString()} class="blog-card-date">
                {formatBlogDate(post.date)}
              </time>
              <h2 class="blog-card-title">{post.data.title}</h2>
              {post.data.description && <p class="blog-card-excerpt">{post.data.description}</p>}
              <span class="blog-card-cta inline-flex items-center" aria-hidden="true">
                Read post
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path
                    d="M1 6h10M7 2l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </article>
        ))
      }
    </div>

    {
      totalPages > 1 && (
        <nav
          class="blog-pagination flex items-center justify-between gap-4"
          aria-label="Blog pagination"
        >
          <span class="pagination-info">Page 1 of {totalPages}</span>
          <a href="/blog/page/2/" class="nr-btn nr-btn-primary">
            Older posts &rarr;
          </a>
        </nav>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Breadcrumb bar styles live in BaseLayout (global) to keep parity
     across blog/about/blogpost. */

  .blog-container {
    max-width: var(--nr-content-box-width);
    margin: 0 auto;
    padding: var(--space-6) var(--grid-padding) var(--space-8);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-5);
  }

  .blog-card {
    background: var(--nr-surface-elevated);
    border: 1px solid var(--nr-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard);
    position: relative;
    overflow: hidden;
  }

  .blog-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--nr-red);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--duration-normal) var(--ease-standard);
  }

  .blog-card:hover {
    border-color: rgba(218, 0, 0, 0.35);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .blog-card:hover::before {
    transform: scaleY(1);
    transform-origin: top;
  }

  .blog-card-featured {
    grid-column: 1 / -1;
    background: var(--nr-red-light);
    border-color: rgba(218, 0, 0, 0.25);
  }

  /* Dark mode drops the red wash. A 10% red over #1F1F23 came out as a muddy
     maroon block, the only filled panel on an otherwise unfilled page, and it
     dulled the title sitting on it. The permanently-extended red bar and the
     red-tinted border already say "featured", so the card keeps the same surface
     as its siblings and lets those two carry it. Light mode keeps its wash, where
     --nr-red-light is a pale tint rather than a muddy one. */
  :root[data-theme='dark'] .blog-card-featured {
    background: var(--nr-surface-elevated);
    border-color: rgba(218, 0, 0, 0.35);
  }

  .blog-card-featured::before {
    transform: scaleY(1);
    transform-origin: top;
  }

  .blog-card-link {
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .blog-card-link:hover {
    text-decoration: none;
    color: inherit;
  }

  .blog-card-date {
    display: block;
    font-size: var(--text-overline);
    color: var(--nr-text-faint);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  /* The featured card is the one card with a filled background, and
     --nr-text-faint was tuned against the plain white surface: on the pale red
     wash it drops to 4.44:1, just under AA. One step darker restores it to
     6.5:1. Only needed in light mode, because the dark theme drops the wash (see
     the note above) and the faint token is fine on the shared surface. */
  .blog-card-featured .blog-card-date {
    color: var(--nr-text-muted);
  }

  :root[data-theme='dark'] .blog-card-featured .blog-card-date {
    color: var(--nr-text-faint);
  }

  .blog-card-title {
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--nr-text-strong);
    margin-bottom: var(--space-3);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .blog-card-featured .blog-card-title {
    font-size: var(--text-h2);
    letter-spacing: -0.02em;
    max-width: 60ch;
  }

  .blog-card-excerpt {
    font-size: var(--text-body-sm);
    color: var(--nr-text-muted);
    line-height: 1.65;
    margin: 0 0 var(--space-5);
    flex: 1;
  }

  .blog-card-cta {
    gap: 6px;
    font-size: var(--text-body-sm);
    font-weight: 600;
    /* Red *text*, so it takes the per-theme text token rather than the
       chrome/icon --nr-red. At 15px this needs 4.5:1 and --nr-red gave 3.11
       on the dark card and 4.39 on the light featured card's pink wash;
       --nr-text-link is 5.2:1 dark and 7.1:1 there. */
    color: var(--nr-text-link);
    margin-top: auto;
    transition: gap var(--duration-fast) var(--ease-standard);
  }

  .blog-card:hover .blog-card-cta {
    gap: 10px;
  }

  .blog-card-cta svg {
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .blog-pagination {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--nr-border);
  }

  .pagination-info {
    color: var(--nr-text-faint);
    font-size: var(--text-caption);
    font-family: var(--font-mono);
  }

  @media (max-width: 767px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-card-featured {
      grid-column: auto;
    }
  }
</style>
