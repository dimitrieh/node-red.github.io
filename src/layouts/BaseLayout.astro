---
import { mainNav, footerLinks } from '../data/navigation';

interface Props {
  title: string;
  description?: string;
  /** Optional path to a per-page social-share image (must start with /). */
  ogImage?: string;
}

const { title, description = 'Low-code programming for event-driven applications', ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const resolvedOgImage = new URL(ogImage ?? '/node-red-icon.png', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} - Node-RED</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="Node-RED" />

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@nodered" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,100..900&family=Ubuntu+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="header-logo">
          <img src="/node-red-icon.png" alt="" width="36" height="36" />
          <span class="header-logo-text">Node-RED</span>
        </a>

        <nav class="header-nav" aria-label="Main navigation">
          {mainNav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'header-nav-link',
                { 'is-active': item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href) && !item.external }
              ]}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              {...(!item.external && (item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href)) ? { 'aria-current': 'page' } : {})}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <button class="mobile-toggle" aria-label="Toggle menu" aria-controls="mobile-nav" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="19" y2="6" />
            <line x1="3" y1="11" x2="19" y2="11" />
            <line x1="3" y1="16" x2="19" y2="16" />
          </svg>
        </button>
      </div>

      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
        {mainNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'mobile-nav-link',
              { 'is-active': item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href) && !item.external }
            ]}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer" aria-label="Site footer">
      <div class="footer-main">
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <img src="/node-red-icon.png" alt="" width="44" height="44" />
            <span>Node-RED</span>
          </a>
          <p class="footer-tagline">Low-code programming for event-driven applications</p>
        </div>

        <div class="footer-links">
          {footerLinks.map((section) => (
            <div class="footer-link-group">
              <p class="footer-link-title">{section.title}</p>
              <ul>
                {section.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="footer-bottom">
        <div class="footer-bottom-inner">
          <div class="footer-legal">
            <p>
              Copyright &copy; OpenJS Foundation and Node-RED contributors. All rights reserved.
              The <a href="https://openjsf.org">OpenJS Foundation</a> has registered trademarks and uses trademarks.
              For a list of trademarks of the OpenJS Foundation, please see our <a href="https://trademark-policy.openjsf.org">Trademark Policy</a>
              and <a href="https://trademark-list.openjsf.org">Trademark List</a>.
              <a href="https://terms-of-use.openjsf.org">Terms of Use</a> |
              <a href="https://privacy-policy.openjsf.org">Privacy Policy</a> |
              <a href="https://bylaws.openjsf.org">Bylaws</a> |
              <a href="https://www.linuxfoundation.org/cookies">Cookie Policy</a>
            </p>
            <div class="footer-social">
              <a href="https://social.nodered.org/@nodered" target="_blank" rel="noopener noreferrer me" aria-label="Mastodon">
                <div class="i-simple-icons-mastodon w-5 h-5"></div>
              </a>
              <a href="https://twitter.com/nodered" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                <div class="i-simple-icons-x w-5 h-5"></div>
              </a>
              <a href="https://github.com/node-red" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                <div class="i-simple-icons-github w-5 h-5"></div>
              </a>
            </div>
          </div>
          <a href="https://openjsf.org" target="_blank" rel="noopener noreferrer" class="footer-foundation">
            <img src="/images/openjs_foundation-logo.svg" alt="OpenJS Foundation" />
          </a>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.mobile-toggle');
      const mobileNav = document.querySelector('.mobile-nav');

      const setOpen = (open: boolean) => {
        toggle?.setAttribute('aria-expanded', String(open));
        mobileNav?.setAttribute('aria-hidden', String(!open));
      };

      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        setOpen(!expanded);
      });

      // Close menu when a nav link is activated (so users can navigate)
      mobileNav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });

      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          (toggle as HTMLElement)?.focus();
        }
      });

      // Close on resize past the mobile breakpoint to avoid lingering open state
      const mql = window.matchMedia('(min-width: 1024px)');
      mql.addEventListener?.('change', (e) => {
        if (e.matches) setOpen(false);
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/design-tokens.css';

  /* ── Reset ── */
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* ── Base Typography ── */
  body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--nr-text-body);
    background: var(--nr-surface);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  /* ── Links ── */
  a {
    color: var(--nr-text-link, var(--nr-red));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  a:hover {
    color: var(--nr-red-hover);
    text-decoration-thickness: 2px;
  }

  :root[data-theme='dark'] a:hover {
    color: #E87A7A;
  }

  /* Chrome links (header/footer/nav/cards/buttons/breadcrumbs) suppress the
     body-text underline rule; they have their own affordances. */
  header nav a,
  footer a,
  .nr-btn,
  .nr-btn-primary,
  .nr-btn-secondary,
  .nr-card a,
  .breadcrumb-bar a,
  .header-logo,
  .footer-logo,
  .footer-foundation {
    text-decoration: none;
  }
  /* The legal small-print row in footer keeps round-1 ux #2's underline. */
  .footer-legal a {
    text-decoration: underline;
  }

  /* ── Headings ── */
  h1, h2, h3, h4, h5 {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--nr-text-strong);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  h1 { font-size: var(--text-h1); letter-spacing: -0.025em; }
  h2 { font-size: var(--text-h2); letter-spacing: -0.02em; }
  h3 { font-size: var(--text-h3); letter-spacing: -0.015em; }
  h4 { font-size: var(--text-h4); letter-spacing: -0.01em; }

  /* ── Code ── */
  code {
    font-family: var(--font-mono);
    background: var(--nr-code-bg);
    color: var(--nr-code-text);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  pre {
    background: var(--nr-bg-dark);
    color: #D4D4D4;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    overflow-x: auto;
    box-shadow: var(--shadow-md);
    border: 1px solid #2D2D2D;
  }

  pre code {
    background: none;
    color: inherit;
    padding: 0;
    font-size: var(--text-code);
    line-height: 1.6;
  }

  /* ── Focus ── */
  :focus-visible {
    outline: 3px solid var(--nr-focus);
    outline-offset: 2px;
  }

  /* ── Images ── */
  img {
    max-width: 100%;
    height: auto;
  }

  /* ── Mobile nav toggle ── */
  .mobile-nav[aria-hidden="false"] {
    display: flex;
  }

  /* ── Shared breadcrumb bar (used by /blog, /about, /blog/[post])
        — extracted from per-page styles for consistency and dark-mode
        support. */
  .breadcrumb-bar {
    background: var(--nr-red-hover);
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: 0 var(--grid-padding);
  }

  .breadcrumb-list {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    width: 100%;
    display: flex;
    list-style: none;
    gap: 0;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    flex-wrap: wrap;
  }

  .breadcrumb-list li {
    display: flex;
    align-items: center;
  }

  .breadcrumb-list li::before {
    content: '/';
    color: rgba(255, 255, 255, 0.55);
    margin: 0 10px;
  }

  .breadcrumb-list li:first-child::before {
    content: '';
    margin: 0;
  }

  .breadcrumb-list a,
  .breadcrumb-list span {
    color: #fff;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .breadcrumb-list a:hover {
    text-decoration: underline;
    color: #fff;
  }
</style>

<style>
  /* ===================================================================
     HEADER
     =================================================================== */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    background: var(--nr-red);
    color: var(--nr-white);
    padding: var(--space-2) var(--space-4);
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    z-index: 1000;
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 0;
    color: var(--nr-white);
    text-decoration: none;
  }

  .site-header {
    background: var(--nr-bg-dark);
    border-bottom: 3px solid var(--nr-red);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--grid-padding);
    height: 64px;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
  }

  .header-logo:hover {
    text-decoration: none;
  }

  .header-logo img {
    width: 36px;
    height: 36px;
  }

  .header-logo-text {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 20px;
    color: var(--nr-white);
    letter-spacing: -0.02em;
  }

  .header-nav {
    display: flex;
    gap: 0;
  }

  .header-nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: #A3A3A3;
    text-decoration: none;
    padding: 22px 16px;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
    letter-spacing: -0.01em;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .header-nav-link:hover {
    color: var(--nr-white);
    border-bottom-color: var(--nr-red);
    text-decoration: none;
  }

  .header-nav-link.is-active {
    color: var(--nr-white);
    border-bottom-color: var(--nr-red);
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: 1px solid #3a3a3a;
    border-radius: var(--radius-sm);
    color: #E5E5E5;
    cursor: pointer;
    padding: 6px 8px;
    transition:
      color var(--duration-fast),
      border-color var(--duration-fast),
      background var(--duration-fast);
  }

  .mobile-toggle:hover,
  .mobile-toggle[aria-expanded="true"] {
    color: var(--nr-white);
    border-color: var(--nr-red);
    background: rgba(199, 80, 80, 0.15);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    background: var(--nr-bg-dark);
    padding: 0 var(--grid-padding) var(--space-5);
  }

  .mobile-nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: #A3A3A3;
    text-decoration: none;
    padding: var(--space-3) 0;
    border-bottom: 1px solid #333;
    transition: color var(--duration-fast);
  }

  .mobile-nav-link:hover {
    color: var(--nr-white);
    text-decoration: none;
  }

  .mobile-nav-link.is-active {
    color: var(--nr-white);
  }

  @media (max-width: 1023px) {
    .header-nav { display: none; }
    .mobile-toggle { display: block; }
  }

  /* ===================================================================
     MAIN
     =================================================================== */
  main {
    flex: 1;
  }

  /* ===================================================================
     FOOTER
     =================================================================== */
  .site-footer {
    background: var(--nr-bg-dark);
    color: var(--nr-white);
    margin-top: auto;
  }

  .footer-main {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    padding: var(--space-9) var(--grid-padding) var(--space-8);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-8);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--nr-white);
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer-logo:hover {
    text-decoration: none;
    color: var(--nr-white);
  }

  .footer-logo img {
    width: 44px;
    height: 44px;
  }

  .footer-tagline {
    color: #888;
    font-size: var(--text-body-sm);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .footer-link-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--nr-white);
    margin-bottom: var(--space-4);
    letter-spacing: -0.01em;
  }

  .footer-link-group ul {
    list-style: none;
  }

  .footer-link-group li {
    margin: 0;
  }

  .footer-link-group a {
    color: #999;
    font-size: var(--text-body-sm);
    text-decoration: none;
    transition: color var(--duration-fast);
    display: inline-block;
    padding: 6px 0;
    line-height: 1.5;
  }

  .footer-link-group a:hover {
    color: var(--nr-white);
    text-decoration: none;
  }

  .footer-bottom {
    background: var(--nr-bg-darker);
    padding: var(--space-5) 0;
  }

  .footer-bottom-inner {
    max-width: var(--grid-max-width);
    margin: 0 auto;
    padding: 0 var(--grid-padding);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .footer-legal {
    flex: 1;
  }

  .footer-legal p {
    font-size: 12px;
    color: #888;
    line-height: 1.6;
  }

  .footer-legal a {
    color: #E87070;
    text-decoration: underline;
  }

  .footer-legal a:hover {
    color: #F58A8A;
  }

  .footer-social {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .footer-social a {
    color: #888;
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-social a:hover {
    color: var(--nr-white);
    text-decoration: none;
  }

  .footer-foundation {
    flex-shrink: 0;
  }

  .footer-foundation img {
    height: 40px;
    opacity: 0.7;
    transition: opacity var(--duration-fast);
  }

  .footer-foundation:hover img {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .footer-main {
      grid-template-columns: 1fr;
      padding: var(--space-7) var(--grid-padding) var(--space-6);
      gap: var(--space-7);
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-bottom-inner {
      flex-direction: column;
    }
  }

  @media (max-width: 479px) {
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
